# AI KRİPTO TRADER ayarları
# Bu dosya ".env" adıyla kopyalanır (baslat.bat bunu otomatik yapar). .env Git'e YÜKLENMEZ.

# Çalışma modu:
#   paper   = sanal işlem (varsayılan, para riski YOK)
#   testnet = Binance Testnet (sahte para, gerçek emir akışı denemesi)
#   live    = GERÇEK PARA (aşağıdaki LIVE_ ayarları ve onay satırı olmadan açılmaz)
TRADING_MODE=paper

# Panel giriş bilgileri (mutlaka değiştirin, en az 10 karakter, yalnızca harf ve rakam)
PANEL_USERNAME=admin
PANEL_PASSWORD=

# Sanal başlangıç bakiyesi (USDT)
STARTING_BALANCE=1000

# --- SADECE GERÇEK PARA MODU İÇİN (TRADING_MODE=live) ---
# Okumadan açmayın: GERCEK_PARA_REHBERI.md
# Bu satır, para kaybedebileceğinizi kabul ettiğiniz anlamına gelir. Aynen şöyle yazılmalı:
LIVE_CONFIRM=
# Botun gerçek hesaptan kullanabileceği AZAMİ toplam tutar (USDT)
LIVE_BUDGET_USDT=30
# Tek bir alımın azami tutarı (USDT)
LIVE_MAX_ORDER_USDT=10

# Binance adresleri (genel piyasa verisi, anahtar gerektirmez)
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

DATABASE_URL=sqlite+aiosqlite:///./data/trader.db
