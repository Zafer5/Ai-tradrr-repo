# AI KRİPTO TRADER ayarları
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env dosyası Git'e YÜKLENMEZ.

# Çalışma modu: paper (sanal işlem). testnet ileride eklenecek.
# "live" (gerçek para) modu bu sürümde YOKTUR ve bilerek engellenmiştir.
TRADING_MODE=paper

# Panel giriş bilgileri (mutlaka değiştirin, en az 10 karakter)
PANEL_USERNAME=admin
PANEL_PASSWORD=

# Sanal başlangıç bakiyesi (USDT)
STARTING_BALANCE=1000

# Binance genel piyasa verisi adresleri (anahtar gerektirmez)
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

DATABASE_URL=sqlite+aiosqlite:///./data/trader.db
