# AI KRİPTO YÖNETİCİSİ - ayar dosyası örneği.  Bunu ".env" adıyla kopyalayın:  cp .env.example .env
# .env dosyası ASLA Git'e yüklenmez (.gitignore içindedir). Şifrenizi kimseyle paylaşmayın.

# Panele giriş şifresi (en az 10 karakter)
ADMIN_PASSWORD=

# Oturum/şifreleme anahtarı. Boş bırakırsanız ilk açılışta otomatik üretilip /data içine kaydedilir.
# (Daha sonra değiştirirseniz kayıtlı Testnet anahtarları çözülemez; yeniden girmeniz gerekir.)
SECRET_KEY=

# 0.0.0.0 = aynı ağdaki telefon erişebilir (yalnızca güvendiğiniz Wi-Fi'da). 127.0.0.1 = yalnızca sunucu.
BIND_ADDR=127.0.0.1

# HTTPS arkasında (Cloudflare Tunnel, Tailscale HTTPS vb.) true yapın
COOKIE_SECURE=false

# Binance genel piyasa verisi (API anahtarı gerekmez). Bölgenizde api.binance.com engelliyse
# https://data-api.binance.vision adresini deneyebilirsiniz.
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_TESTNET_REST_URL=https://testnet.binance.vision

LOG_LEVEL=INFO
